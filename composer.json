{
    "name": "bannerstop/mention-api-client",
    "description": "Framework-agnostic PHP client for the mention-api /v2 interface: list, describe and run Queries and Routines with API key or Keycloak client-credentials authentication, typed errors and retries",
    "type": "library",
    "keywords": ["mention", "api-client", "psr-18", "psr-17", "psr-16", "problem-details", "keycloak"],
    "license": "MIT",
    "authors": [
        {
            "name": "bannerstop GmbH",
            "homepage": "https://www.bannerstop.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.4.5",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client (^7.0)",
        "symfony/http-client": "A PSR-18 HTTP client (Psr18Client)",
        "bannerstop/mention-api-client-bundle": "Symfony integration",
        "bannerstop/mention-api-client-laravel": "Laravel integration"
    },
    "autoload": {
        "psr-4": {
            "Bannerstop\\MentionApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bannerstop\\MentionApi\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/mention-api-client"],
    "config": {
        "sort-packages": true
    }
}
