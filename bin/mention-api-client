#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bannerstop\MentionApi\Generator\Console\Application;

if ('cli' !== \PHP_SAPI) {
    fwrite(\STDERR, "mention-api-client runs on the command line only.\n");
    exit(2);
}

$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? null, // set by Composer's vendor/bin proxy
    __DIR__ . '/../vendor/autoload.php',          // this repository
    __DIR__ . '/../../../autoload.php',           // installed as a dependency
];
foreach ($autoloaders as $autoloader) {
    if (null !== $autoloader && is_file($autoloader)) {
        require $autoloader;
        break;
    }
}
if (!class_exists(Application::class)) {
    fwrite(\STDERR, "Cannot find the Composer autoloader; run \"composer install\" first.\n");
    exit(2);
}

$application = new Application(
    static function (string $text): void {
        fwrite(\STDOUT, $text);
    },
    static function (string $text): void {
        fwrite(\STDERR, $text);
    }
);
$env = [];
foreach (array_keys(getenv()) as $name) {
    $value = getenv((string) $name);
    if (\is_string($value)) {
        $env[(string) $name] = $value;
    }
}

exit($application->run(\array_slice($argv, 1), (string) getcwd(), $env));
